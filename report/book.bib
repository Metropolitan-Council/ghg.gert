@report{johnsonPeakCarOwnership2016,
  title = {Peak {{Car Ownership}}:{{The Market Opportunity}} of {{Electric Automated Mobility Services}}},
  shorttitle = {Peak {{Car Ownership}}},
  author = {Johnson, Charlie and Walker, Jonathan},
  date = {2016},
  journaltitle = {Mobility Transformation},
  pages = {1--30},
  institution = {{Rocky Mountain Institute}},
  location = {{Basalt, CO}},
  url = {http://www.rmi.org/peak_car_ownership},
  urldate = {2021-12-15},
  abstract = {The U.S. personal mobility market is worth over \$1 trillion and has been relatively stable for nearly fifty years, with personal vehicles and related services dominating other options such as public transit and taxis in terms of American expenditure. As urbanization increases, infrastructure and mobility systems designed in the 1950s are reaching a breaking point, with growing congestion and pollution, and persistent injuries and fatalities. But after decades of little change in personal mobility, we are now in the formative stages of a powerful confluence of cultural, technological, and societal events. The rise of the ``service economy'' is transferring revenue from products to services. New vehicle technologies like electric powertrains and autonomous driving systems are entering the market and rapidly dropping in cost. When analyzed holistically, this confluence creates the possibility for a new mobility system to emerge in the next few years that is superior to our existing system in almost every way.},
  langid = {english}
}

