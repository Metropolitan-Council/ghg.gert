@article{lehner_price_2019,
	title = {The Price Elasticity of Parking: A Meta-Analysis},
	volume = {121},
	issn = {0965-8564},
	url = {https://www.sciencedirect.com/science/article/pii/S0965856417308832},
	doi = {10.1016/j.tra.2019.01.014},
	shorttitle = {The Price Elasticity of Parking},
	abstract = {The effect of parking fees on parking demand has been investigated in many different contexts, applying a wide variety of study designs. Research that brings together the knowledge derived in these studies systematically, however, is scarce. We conduct a meta-analysis of parking price elasticities based on 50 studies. Using seemingly unrelated regression models we account for the interdependence between the price elasticity of occupancy ({EPO}), dwell time ({EPD}), and volume ({EPV}). We show that estimates of parking elasticities based on stated preference ({SP}) data lead to different managerial and policy insights than estimates based on revealed preference ({RP}) data. Given a large amount of reported and unreported variation between the existing studies on parking price elasticities, we provide concrete recommendations for future studies that should warrant a higher degree of comparability and coherence in research design, conduction, and reporting.},
	pages = {177--191},
	journaltitle = {Transportation Research Part A: Policy and Practice},
	shortjournal = {Transportation Research Part A: Policy and Practice},
	author = {Lehner, Stephan and Peer, Stefanie},
	urldate = {2021-12-15},
	date = {2019-03-01},
	keywords = {Meta-analysis, Parking demand, Parking occupancy, Price elasticity, {SUR}},
}

